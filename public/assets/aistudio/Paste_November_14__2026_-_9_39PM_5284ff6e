                <div id="error-nombre" class="error-mensaje">Por favor ingresa tu nombre</div>
                
                <input type="email" id="email-cotizacion" placeholder="Tu correo electrónico" required><br>
                <div id="error-email" class="error-mensaje">Por favor ingresa un email válido</div>
                
                <input type="tel" id="telefono-cotizacion" placeholder="Tu número de teléfono" required><br>
                <div id="error-telefono" class="error-mensaje">Por favor ingresa un teléfono válido</div>
                
                <textarea id="detalles-cotizacion" placeholder="Por favor proporcione al menos 20 caracteres en los detalles de su solicitud" required></textarea><br>
                <div id="error-detalles" class="error-mensaje">Por favor proporcione al menos 20 caracteres en los detalles de su solicitud</div>
                
                <input type="hidden" id="servicio-cotizacion" value="${servicio}">
                <div class="botones-formulario">
                    <button id="enviar-cotizacion" class="boton-enviar">Enviar solicitud</button>
                    <button id="cancelar-cotizacion" class="boton-cancelar">Cancelar</button>
                </div>
            </div>
        `;
        chatMessages.appendChild(mensajeAsistente);
        
        // Scroll suave hasta el formulario
        setTimeout(() => {
            mensajeAsistente.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }, 100);
        
        // Event listener para el botón de enviar
        document.getElementById('enviar-cotizacion').addEventListener('click', enviarCotizacion);
        
        // Event listener para el botón de cancelar (mejorado)
        document.getElementById('cancelar-cotizacion').addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            
            // Elimina solo el formulario
            const formulario = document.getElementById('formulario-cotizacion');
            if (formulario) {
                formulario.parentNode.remove();
            }
            
            // Muestra los servicios nuevamente
            mostrarBotonesServicios();
        });
        
        // Validación en tiempo real
        document.getElementById('nombre-cotizacion').addEventListener('input', validarNombre);
        document.getElementById('email-cotizacion').addEventListener('input', validarEmail);
        document.getElementById('telefono-cotizacion').addEventListener('input', validarTelefono);
        document.getElementById('detalles-cotizacion').addEventListener('input', validarDetalles);
    }

    function validarNombre() {
        const nombre = document.getElementById('nombre-cotizacion').value.trim();
        const error = document.getElementById('error-nombre');
        
        if (nombre.length < 3) {
            error.style.display = 'block';
            return false;
        } else {
            error.style.display = 'none';
            return true;
        }
    }

    function validarEmail() {
        const email = document.getElementById('email-cotizacion').value.trim();
        const error = document.getElementById('error-email');
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        if (!emailRegex.test(email)) {
            error.style.display = 'block';
            return false;
        } else {
            error.style.display = 'none';
            return true;
        }
    }

    function validarTelefono() {
        const telefono = document.getElementById('telefono-cotizacion').value.trim();
        const error = document.getElementById('error-telefono');
        const telefonoRegex = /^[0-9]{8,15}$/;
        
        if (!telefonoRegex.test(telefono)) {
            error.style.display = 'block';
            return false;
        } else {
            error.style.display = 'none';
            return true;
        }
    }

    function validarDetalles() {
        const detalles = document.getElementById('detalles-cotizacion').value.trim();
        const error = document.getElementById('error-detalles');
        
        if (detalles.length < 20) {
            error.textContent = 'Por favor proporcione al menos 20 caracteres en los detalles de su solicitud';
            error.style.display = 'block';
            return false;
        } else {
            error.style.display = 'none';
            return true;
        }
    }

    function validarFormulario() {
        const valido = 
            validarNombre() && 
            validarEmail() && 
            validarTelefono() && 
            validarDetalles();
        
        return valido;
    }

    async function enviarCotizacion() {
        if (!validarFormulario()) {
            const errorDiv = document.createElement('div');
            errorDiv.className = 'mensaje-bot error';
            errorDiv.innerHTML = '<strong>Error:</strong> Por favor complete todos los campos correctamente, asegurándose de incluir al menos 20 caracteres en los detalles.';
            chatMessages.appendChild(errorDiv);
            return;
        }
        
        const nombre = document.getElementById('nombre-cotizacion').value.trim();
        const email = document.getElementById('email-cotizacion').value.trim();
        const telefono = document.getElementById('telefono-cotizacion').value.trim();
        const detalles = document.getElementById('detalles-cotizacion').value.trim();
        const servicio = document.getElementById('servicio-cotizacion').value.trim();
        
        const cargaDiv = document.createElement('div');
        cargaDiv.className = 'cargando';
        cargaDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Enviando solicitud...';
        chatMessages.appendChild(cargaDiv);
        
        try {
            const response = await fetch('backend.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `accion=enviar_cotizacion&nombre=${encodeURIComponent(nombre)}&email=${encodeURIComponent(email)}&telefono=${encodeURIComponent(telefono)}&detalles=${encodeURIComponent(detalles)}&servicio=${encodeURIComponent(servicio)}`
            });
            
            cargaDiv.remove();
            const data = await response.json();
            
            if (data.error) {
                mostrarMensaje(data.error, 'bot');
            } else {
                mostrarMensaje(data.mensaje, 'bot');
                document.getElementById('formulario-cotizacion').style.display = 'none';
            }
        } catch (error) {
            cargaDiv.remove();
            mostrarMensaje('Error al enviar la solicitud. Por favor intente nuevamente.', 'bot');
            console.error('Error:', error);
        }
    }

    function enviarSugerencia(texto, index) {
        if (texto === 'Servicios') {
            mostrarBotonesServicios();
        } else if (texto === 'Cotización') {
            mostrarFormularioCotizacion();
        } else {
            chatInput.value = textosSugerencias[index];
            enviarMensaje();
        }
    }

    async function enviarMensaje() {
        const mensaje = chatInput.value.trim();
        if (!mensaje) return;

        mostrarMensaje(mensaje, 'usuario');
        chatInput.value = '';

        const cargaDiv = document.createElement('div');
        cargaDiv.className = 'cargando';
        cargaDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Pensando...';
        chatMessages.appendChild(cargaDiv);

        try {
            const response = await fetch('backend.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'mensaje=' + encodeURIComponent(mensaje),
            });

            cargaDiv.remove();
            const data = await response.json();

            if (data.error) {
                mostrarMensaje(data.error, 'bot');
            } else {
                const separador = document.createElement('div');
                separador.className = 'separador';
                separador.innerHTML = '---';
                chatMessages.appendChild(separador);
                mostrarMensaje(data.respuesta, 'bot');
                
                // Scroll suave hasta el primer mensaje del asistente
                setTimeout(() => {
                    const mensajesBot = document.querySelectorAll('.mensaje-bot');
                    if (mensajesBot.length > 0) {
                        mensajesBot[mensajesBot.length - 1].scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }, 100);
            }
        } catch (error) {
            cargaDiv.remove();
            mostrarMensaje('Error de conexión. Intenta nuevamente.', 'bot');
            console.error('Error:', error);
        }
    }

    // Event listeners
    chatbotBtn.addEventListener('click', abrirChat);
    closeBtn.addEventListener('click', cerrarChat);
    chatSend.addEventListener('click', enviarMensaje);
    chatInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            enviarMensaje();
        }
    });

    suggestionBtns.forEach((btn, index) => {
        btn.addEventListener('click', () => enviarSugerencia(textosSugerencias[index], index));
    });

    document.addEventListener('click', function(e) {
        if (!chatAbierto) return;
        
        // Verificar si el clic fue en el formulario
        const formulario = document.getElementById('formulario-cotizacion');
        const esClicEnFormulario = formulario && formulario.contains(e.target);
        
        // Solo cerrar si no es en el chatbot ni en el formulario
        if (!chatbotContainer.contains(e.target) && 
            e.target !== chatbotBtn && 
            !esClicEnFormulario) {
            cerrarChat();
        }
    });

    // Event listener para el botón "Ver otros servicios"
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('otro-servicio-btn') || 
            e.target.closest('.otro-servicio-btn')) {
            mostrarBotonesServicios();
        }
    });
</script>

