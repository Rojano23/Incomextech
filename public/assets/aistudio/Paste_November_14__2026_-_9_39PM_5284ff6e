        chatbotContainer.style.display = 'none';
        chatbotBtn.style.display = 'flex';
    }

    function mostrarMensaje(texto, tipo) {
        const mensajeDiv = document.createElement('div');
        mensajeDiv.className = `mensaje-${tipo}`;
        mensajeDiv.innerHTML = `<strong>${tipo === 'usuario' ? 'Tú' : 'Asistente'}:</strong> ${texto}`;
        chatMessages.appendChild(mensajeDiv);
    }

    function mostrarBotonesServicios() {
        // Limpiar el chat antes de mostrar los servicios
        while (chatMessages.firstChild) {
            chatMessages.removeChild(chatMessages.firstChild);
        }
        
        // Limpia el input
        chatInput.value = '';
        
        // Crea contenedor para botones de servicios
        const serviciosContainer = document.createElement('div');
        serviciosContainer.className = 'suggestion-buttons servicios-container';
        
        // Agrega título
        const titulo = document.createElement('div');
        titulo.className = 'mensaje-bot';
        titulo.innerHTML = '<strong>Selecciona un servicio para ver detalles:</strong>';
        chatMessages.appendChild(titulo);
        
        // Crea botones para cada servicio
        Object.keys(servicios).forEach(servicio => {
            const btn = document.createElement('button');
            btn.className = 'suggestion-btn servicio-btn';
            btn.textContent = servicio;
            btn.addEventListener('click', () => {
                // Muestra la respuesta directamente sin enviar al backend
                const respuestaDiv = document.createElement('div');
                respuestaDiv.className = 'mensaje-bot';
                respuestaDiv.innerHTML = servicios[servicio];
                chatMessages.appendChild(respuestaDiv);
                
                // Scroll suave hasta el inicio del mensaje del servicio
                setTimeout(() => {
                    respuestaDiv.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }, 100);
                
                // Agrega el event listener para los botones recién creados
                setTimeout(() => {
                    document.querySelectorAll('.cotizar-servicio-btn').forEach(cotizarBtn => {
                        cotizarBtn.addEventListener('click', function() {
                            const servicio = this.getAttribute('data-servicio');
                            mostrarFormularioCotizacion(servicio);
                        });
                    });
                }, 100);
            });
            serviciosContainer.appendChild(btn);
        });
        
        chatMessages.appendChild(serviciosContainer);
        
        // Scroll suave hasta el título de servicios
        setTimeout(() => {
            titulo.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }, 100);
    }

    function mostrarFormularioCotizacion(servicio = '') {
        // Limpiar el input
        chatInput.value = '';
        
        // Crear mensaje del asistente
        const mensajeAsistente = document.createElement('div');
        mensajeAsistente.className = 'mensaje-bot';
        mensajeAsistente.innerHTML = `
            <strong>Cotización${servicio ? ' para ' + servicio : ''}</strong><br><br>
            Por favor proporcione los siguientes detalles:<br>
            <div id="formulario-cotizacion" style="margin-top:15px;">
